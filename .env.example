GEMINI_API_KEY=your-key-here
# Leave GEMINI_MODEL empty to use the default (gemini-3.6-flash).
GEMINI_MODEL=
ALLOWED_ORIGINS=http://localhost:5173
MAX_UPLOAD_MB=5
MAX_ROWS=500
GIT_SHA=
# AI abuse limits: per client per minute and per day, and model calls per day for everyone.
AI_REQUESTS_PER_MINUTE=6
AI_REQUESTS_PER_DAY=100
AI_MODEL_CALLS_PER_DAY=500
# Proxies in front of the app (Render = 1; verify after deploying, see docs/SETUP_AND_DEPLOYMENT.md). Use 0 if exposed directly.
TRUSTED_PROXY_HOPS=1
# Optional Langfuse tracing of the AI flows. Off unless both keys are set, and it also needs
# `pip install langfuse`. Traces contain prompts and answers (holding names included).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=
